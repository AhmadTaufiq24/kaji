{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "worker:dev": "pnpm with-env tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:generate": "pnpm with-env prisma generate",
    "db:deploy": "pnpm with-env prisma migrate deploy",
    "db:studio": "pnpm with-env prisma studio",
    "eval": "pnpm with-env tsx src/scripts/run-eval.ts",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@anvia/core": "0.13.5",
    "@anvia/openai": "0.3.21",
    "@anvia/server": "0.5.11",
    "@hono/node-server": "2.0.10",
    "@hono/zod-validator": "0.9.0",
    "@kaji/agent": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bullmq": "5.81.2",
    "dotenv": "17.2.2",
    "hono": "4.12.31",
    "ioredis": "5.11.1",
    "prisma": "7.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "tsx": "4.23.1",
    "typescript": "5.9.2"
  }
}
